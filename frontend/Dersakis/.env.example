# Kopyala: .env.local olarak kaydet (git'e girmez) ve kendi IP'nle doldur.
# Telefondan test: bilgisayarının LAN IP'si, ör. http://192.168.1.20:5267
# Android emülatörü: http://10.0.2.2:5267   |   iOS simülatörü: http://localhost:5267
EXPO_PUBLIC_API_ORIGIN=http://192.168.1.20:5267
# Push için EAS proje kimliği (eas init sonrası app.json > extra.eas.projectId ile aynı). Boş bırakılabilir.
EXPO_PUBLIC_EAS_PROJECT_ID=
